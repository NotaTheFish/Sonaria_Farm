TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
ADMIN_TELEGRAM_ID=123456789
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Опционально: зафиксировать ожидаемую ревизию Alembic (строгая проверка при старте бота/воркера).
# Если не задавать — достаточно любой применённой миграции (alembic_version не пустой).
# ALEMBIC_EXPECTED_REVISION=20260319_0001

# Воркер: stub = без файловых мостов; windows = WindowsGameAdapter (файловые мосты в runtime/)
# GAME_ADAPTER=stub
# GAME_ADAPTER=windows
# WORKER_ROLE=farmer
# Не задавай WORKER_ACCOUNT_ID с пустым значением — либо UUID аккаунта, либо убери строку целиком.
# WORKER_ACCOUNT_ID=
# WORKER_INSTANCE_NAME=pc1-slot-01
# WORKER_POLL_SECONDS=2.0
# WORKER_LEASE_SECONDS=90
# Постоянный id воркера (иначе при каждом перезапуске новый UUID и конфликт по WORKER_INSTANCE_NAME):
# WORKER_ID=b7993762-c7f6-45d8-be17-be240a00000b
# Если старый процесс убит, новый может отобрать инстанс после тишины heartbeat (секунды):
# WORKER_STALE_HEARTBEAT_SECONDS=180

# Windows login_and_check bridge (для WindowsGameAdapter):
# внешний процесс должен писать результат проверки в файл:
#   <LOGIN_CHECK_RESULTS_DIR>/<account_id>.json
# пример JSON: {"status":"banned","reason":"roblox_platform_ban"}
# LOGIN_CHECK_RESULTS_DIR=runtime/login_check_results
# LOGIN_CHECK_TIMEOUT_SECONDS=180
# LOGIN_CHECK_POLL_SECONDS=1.0

# Windows farm_tick bridge: воркер пишет запрос, внешний процесс — ответ (один шаг цикла за вызов).
#   FARM_TICK_DIR/<task_id>.request.json  →  FARM_TICK_DIR/<task_id>.response.json
# FARM_TICK_DIR=runtime/farm_tick
# При старте воркера очистить все *.request.json / *.response.json в FARM_TICK_DIR (1 воркер = 1 папка):
# FARM_TICK_CLEAN_ON_START=1
# FARM_TICK_TIMEOUT_SECONDS=120
# FARM_TICK_POLL_SECONDS=1.0
# Раз в N секунд в консоль воркера — куда именно ждётся response и какие файлы в каталоге:
# FARM_TICK_DIAGNOSTIC_SECONDS=15

# transfer_to_storage / set_sell_price — те же имена файлов {task_id}.request.json → .response.json
# TRANSFER_BRIDGE_DIR=runtime/transfer_bridge
# TRANSFER_BRIDGE_TIMEOUT_SECONDS=120
# TRANSFER_BRIDGE_POLL_SECONDS=1.0
# SELL_BRIDGE_DIR=runtime/sell_bridge
# SELL_BRIDGE_TIMEOUT_SECONDS=120
# SELL_BRIDGE_POLL_SECONDS=1.0

# Тест: python scripts/file_bridge_echo.py — авто-ok на все мосты (осторожно с активным фармом)
# BRIDGE_ECHO_POLL=0.5
