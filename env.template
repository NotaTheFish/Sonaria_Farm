# =============================================================================
# Sonaria Farm — шаблон переменных окружения
# =============================================================================
# Как использовать (Windows, из корня репозитория):
#   copy env.template .env
# Затем открой .env и подставь свои секреты (токен бота, DATABASE_URL, …).
# Файл .env в git не коммитится.
#
# Документация: README.md, docs/GUIDE_WORKER_WINDOWS_RAILWAY.md
# =============================================================================

# -----------------------------------------------------------------------------
# Обязательно: Telegram-бот (Railway или локально)
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=ВСТАВЬ_ТОКЕН_ОТ_BOTFATHER
ADMIN_TELEGRAM_ID=ВСТАВЬ_СВОЙ_TELEGRAM_USER_ID_ЧИСЛОМ

# -----------------------------------------------------------------------------
# Обязательно: PostgreSQL (бот и воркер)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DBNAME

# Строго проверять ревизию Alembic при старте (опционально):
# ALEMBIC_EXPECTED_REVISION=20260320_0005

# -----------------------------------------------------------------------------
# Воркер (Windows; на Railway бот без воркера)
# -----------------------------------------------------------------------------
GAME_ADAPTER=stub
# Для файловых мостов в runtime/:
# GAME_ADAPTER=windows

WORKER_ROLE=farmer
# UUID аккаунта из таблицы accounts — только если этот воркер закреплён за одним аккаунтом.
# Не оставляй пустую строку: либо реальный UUID, либо удали переменную.
# WORKER_ACCOUNT_ID=

# Уникальное имя слота Roblox/инстанса на этой машине:
WORKER_INSTANCE_NAME=pc1-slot-01

WORKER_POLL_SECONDS=2.0
WORKER_LEASE_SECONDS=90

# Постоянный ID воркера (иначе после каждого перезапуска новый UUID):
# WORKER_ID=

# Перехват «зависшего» инстанса после тишины heartbeat (секунды):
WORKER_STALE_HEARTBEAT_SECONDS=180

# -----------------------------------------------------------------------------
# Stub-адаптер (отладка без Roblox)
# -----------------------------------------------------------------------------
# STUB_INVENTORY_DEMO=1

# -----------------------------------------------------------------------------
# Универсальные Lua: script_params в JSON моста (см. docs/SCRIPT_PARAMS_AND_LUA.md)
# -----------------------------------------------------------------------------
STOP_FLAG_DIR=runtime/stop_flags
# Не писать пароль в request.json (рекомендуется):
SCRIPTS_INCLUDE_PASSWORD_IN_BRIDGE=0

# -----------------------------------------------------------------------------
# Файловый мост: login_and_check
# -----------------------------------------------------------------------------
LOGIN_CHECK_RESULTS_DIR=runtime/login_check_results
LOGIN_CHECK_TIMEOUT_SECONDS=180
LOGIN_CHECK_POLL_SECONDS=1.0

# -----------------------------------------------------------------------------
# Файловый мост: farm_tick
# -----------------------------------------------------------------------------
FARM_TICK_DIR=runtime/farm_tick
# FARM_TICK_CLEAN_ON_START=1
FARM_TICK_TIMEOUT_SECONDS=120
FARM_TICK_POLL_SECONDS=1.0
FARM_TICK_DIAGNOSTIC_SECONDS=15

# -----------------------------------------------------------------------------
# Файловый мост: transfer / sell
# -----------------------------------------------------------------------------
TRANSFER_BRIDGE_DIR=runtime/transfer_bridge
TRANSFER_BRIDGE_TIMEOUT_SECONDS=120
TRANSFER_BRIDGE_POLL_SECONDS=1.0

SELL_BRIDGE_DIR=runtime/sell_bridge
SELL_BRIDGE_TIMEOUT_SECONDS=120
SELL_BRIDGE_POLL_SECONDS=1.0

# Один корень для трёх каталогов моста (если не задаёшь пути по отдельности):
# FILE_BRIDGE_ROOT=runtime/game_bridge

# Один каталог + теги в имени файла (см. docs/EXTERNAL_BRIDGE_CLIENT.md):
# FILE_BRIDGE_UNIFIED_DIR=runtime/file_bridge

# -----------------------------------------------------------------------------
# Опционально: subprocess инжектора / лаунчера (см. farm/game/injector_launcher.py)
# -----------------------------------------------------------------------------
# INJECTOR_ENABLED=1
# INJECTOR_PATH="C:\Program Files\jjsploit\jjsploit.exe"
# INJECTOR_SCRIPTS_DIR=external/scripts
# Универсальный скрипт Kimi (отдельно от legacy external/scripts/*.lua):
# INJECTOR_UNIVERSAL_SCRIPT_PATH=external/injector_scripts/universal_sonaria_bot.lua
# ROBLOX_PID=12345
# UNIVERSAL_INVENTORY_TIMEOUT_SECONDS=120
# DEX_MODEL_PATH=Dex_roblox.rbxm
# Для JJSploit fallback через loadstring(HttpGet):
# DEX_LOADER_URL=https://cdn.wearedevs.net/scripts/Dex Explorer V2.txt
# never | windows_adapter_init | every_farm_tick
# INJECTOR_LAUNCH_WHEN=windows_adapter_init
# INJECTOR_ARGS_JSON=[]
# INJECTOR_TIMEOUT_SECONDS=30
# INJECTOR_NO_WINDOW=0

# Заготовки под будущий запуск Roblox от разных пользователей Windows:
# ROBLOX_EXE=C:\Path\To\RobloxPlayerBeta.exe
# WINDOWS_USER_TEMPLATE=rbx_{account_short}

# -----------------------------------------------------------------------------
# Скрипты отладки моста (не обязательны в проде)
# -----------------------------------------------------------------------------
# BRIDGE_ECHO_POLL=0.5
# BRIDGE_SIDECAR_POLL=0.5
# BRIDGE_SIDECAR_AUTO_OK=1
# BRIDGE_SIDECAR_VERBOSE=0
